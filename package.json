{
  "name": "gavdaly",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "astro check",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:visual": "playwright test visual",
    "test:e2e:visual:update": "playwright test visual --update-snapshots",
    "lint": "eslint 'src/**/*.{astro,ts,tsx}' --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:md": "markdownlint-cli2",
    "lint:spell": "cspell --no-progress --no-summary '**/*.{md,mdx,astro,ts,tsx}'",
    "lint:links": "remark -q -f .",
    "lint:prune": "ts-prune --error",
    "qa:content": "npm run lint:md && npm run lint:links && npm run lint:spell",
    "typecheck:workers": "tsc --noEmit -p tsconfig.workers.json",
    "lint:all": "npm run lint && npm run lint:md && npm run lint:spell && npm run lint:prune",
    "test:lhci": "npm run build && lhci autorun --config=lighthouserc.json",
    "prepare": "husky",
    "astro": "astro",
    "cf:dev": "wrangler pages dev --compatibility-date=2024-12-01",
    "d1:migrate": "wrangler d1 migrations apply your-d1-db",
    "d1:console": "wrangler d1 execute your-d1-db --local --command '.tables'"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/solid-js": "^7.0.2",
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/resize": "^2.1.1",
    "@jsquash/webp": "^1.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.7",
    "astro-robots-txt": "^1.0.0",
    "astro-seo": "^1.1.0",
    "marked": "^18.0.11",
    "solid-js": "^1.9.15",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^5.20260826.1",
    "@playwright/test": "^1.62.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "cspell": "^10.1.1",
    "depcheck": "^1.4.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "remark-cli": "^12.0.1",
    "remark-validate-links": "^13.1.0",
    "ts-prune": "^0.10.3"
  },
  "lint-staged": {
    "**/*.{astro,ts,tsx}": [
      "eslint --max-warnings=0"
    ],
    "**/*.{md,mdx}": [
      "markdownlint-cli2"
    ],
    "**/*.{md,mdx,astro,ts,tsx}": [
      "cspell --no-progress --no-summary"
    ]
  }
}
